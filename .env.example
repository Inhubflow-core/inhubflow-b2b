# Copy this file to .env.local and fill in your values

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Password to log in to the InHubFlow UI
AUTH_PASSWORD=

# Internal secret for server-to-server API calls (e.g. the MCP server calling InHubFlow's own
# /api/* routes over loopback). Generate with: openssl rand -base64 32
# Never sent to a browser or exposed externally — only Node processes on this host see it.
INTERNAL_API_SECRET=

# SQLite database path (optional — defaults to ./inhubflow.db in cwd, legacy ./linki.db also supported)
# When running via Docker, this is set automatically to /data/inhubflow.db
INHUBFLOW_DB_PATH=

# Unipile is the only LinkedIn campaign and inbox transport.
# DSN example: https://apiXX.unipile.com:12345
UNIPILE_DSN=
UNIPILE_API_KEY=
# App-owned secret that signs Hosted Auth callback state. Generate independently:
# openssl rand -hex 32
UNIPILE_CALLBACK_SECRET=
# Authentication for legacy v1 webhooks: configure the same value as the
# X-InHubFlow-Webhook-Token custom header on every v1 webhook.
UNIPILE_WEBHOOK_TOKEN=
# Optional HMAC secrets when using the newer v2 Webhook Endpoints API.
UNIPILE_WEBHOOK_SECRET=
UNIPILE_WEBHOOK_SECRETS=
# Configure enabled webhooks pointing to /api/webhooks/unipile for:
# messaging/message_received, users/new_relation, and account_status.

# Optional startup admin seeding and instance settings
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
SLOTS_LIMIT=4
COMPANY_NAME=

# Gemini SDR provider and fail-closed runtime gates. Keep every outbound gate false
# until the documented approval/canary/promotion checkpoints have passed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
SDR_RUNTIME_ENABLED=false
SDR_PROVIDER_ENABLED=false
SDR_AGENT_MODE=off
SDR_WORKER_POLL_MS=5000
SDR_SIMULATION_LIVE_ENABLED=false
SDR_OUTBOUND_ENABLED=false
SDR_LINKEDIN_OUTBOUND_ENABLED=false
SDR_EMAIL_OUTBOUND_ENABLED=false
SIGNAL_RADAR_POLL_MS=60000
NATIVE_CALENDAR_ENABLED=false
# Optional accounting rates; set from the provider pricing applicable to your account.
GEMINI_INPUT_COST_PER_MILLION_USD=
GEMINI_OUTPUT_COST_PER_MILLION_USD=

# Durable in-app + Web Push handoff notifications. Generate keys with:
# npx web-push generate-vapid-keys
WEB_PUSH_ENABLED=false
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# SMTP/IMAP compatibility and generated Message-ID domain for manual Inbox replies.
SMTP_ALLOW_SELF_SIGNED=false
IMAP_ALLOW_SELF_SIGNED=false
EMAIL_MESSAGE_ID_DOMAIN=

# Resend Transactional Email Configuration (Welcome & Credentials Delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL="InHubFlow B2B Suite <info@inhubflow.online>"
# Serper.dev Google Search API Key (Zero CAPTCHA X-Ray Lead Search)
SERPER_API_KEY=
